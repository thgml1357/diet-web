# Copy to .env and fill in. Never commit .env.
# Supabase dashboard -> Project Settings -> API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key: safe to ship in a client app, access is limited by RLS
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# service_role key: bypasses RLS. Server-side only, NEVER put it in the app. (Not needed by the examples.)
# SUPABASE_SERVICE_ROLE_KEY=

# Credentials of the user the example scripts and scripts/*.py log in as (friends: this is all you need; no service key)
# (create it in Dashboard -> Authentication -> Users, tick "Auto Confirm User")
DIET_USER_EMAIL=you@example.com
DIET_USER_PASSWORD=change-me
